# DesignJet print server configuration.
#
#   cp config.env.example config.env   &&   edit   &&   ./bootstrap.sh
#
# config.env is gitignored -- it holds your LAN details, not anything secret,
# but there is no reason to publish your network layout either.

# ---------------------------------------------------------------------------
# The plotter
# ---------------------------------------------------------------------------

# The DesignJet's IP address. Find it on the plotter:
#   Setup > Connectivity > Gigabit Ethernet > View information
#
# Give it a DHCP reservation on your router, or set a static IP from the front
# panel. If this address changes, the queue stops working until you re-run
# ./scripts/add-queue.sh.
PLOTTER_IP=192.168.1.50

# Raw TCP / JetDirect port. 9100 unless you have deliberately changed it.
PLOTTER_PORT=9100

# Carriage width in inches: 24 or 44. This decides which paper sizes the
# generated PPD offers -- a 24 in machine will not be offered A0.
PLOTTER_WIDTH_IN=24

# ---------------------------------------------------------------------------
# The queue
# ---------------------------------------------------------------------------

# Queue name. Letters, digits, hyphens and underscores only -- no spaces.
# This becomes part of the IPP URL, so keep it short.
QUEUE_NAME=DesignJet-T1200

# Shown as the printer name on the Mac.
QUEUE_DESC="HP DesignJet T1200ps"

# Free text, shown under "Location" in the Mac's printer list.
QUEUE_LOCATION="Studio"

# Make this the default printer on the print server itself. Does not affect
# the Mac's default printer.
SET_AS_DEFAULT=yes

# ---------------------------------------------------------------------------
# Default print settings
# ---------------------------------------------------------------------------
# These are the queue defaults. Anything the Mac specifies in the print dialog
# overrides them per job.

# Any media name from the generated PPD: A4 A3 A2 A1 A0, Letter Legal Tabloid,
# AnsiC AnsiD AnsiE, ARCHA..ARCHE, Roll24 Roll36 Roll42 Roll44.
DEFAULT_MEDIA=A1

# Roll | Sheet | Auto
DEFAULT_SOURCE=Roll

# 300dpi (fast) | 600dpi (normal) | 1200dpi (best)
DEFAULT_QUALITY=600dpi

# CMYK (colour) | Gray (greyscale)
DEFAULT_COLOR=CMYK

# ---------------------------------------------------------------------------
# Bonjour advertisement
# ---------------------------------------------------------------------------

# Advertise a URF (Apple raster) profile in the Bonjour record.
#
#   no  -- correct for printing from Macs, which will send PDF. Default.
#   yes -- needed before an iPhone or iPad will offer the plotter at all.
#          Costs an extra raster conversion on the server for iOS jobs.
ADVERTISE_URF=no
